# Local: compose Postgres. Neon (prod) needs the asyncpg scheme and TLS:
#   postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require
DATABASE_URL=postgresql+asyncpg://fw:fw@db:5432/friendly_wager
TEST_DATABASE_URL=postgresql+asyncpg://fw:fw@db:5432/friendly_wager_test
# at least 32 characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=change-me-to-a-random-string-of-32-plus-chars
INVITE_CODE=change-me-invite
# at least 16 characters (e.g. `openssl rand -base64 24`)
SYNC_SECRET=change-me-sync-secret-123
COOKIE_SECURE=false
API_URL=http://api:8000

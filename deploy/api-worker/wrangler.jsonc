{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "fw-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"routes": [
		{ "pattern": "api.pickem.cc", "custom_domain": true },
		// Store app builds from before the move to pickem.cc call this host. It must keep serving, not redirect.
		{ "pattern": "api.sportspicks.cc", "custom_domain": true }
	],
	"triggers": { "crons": ["*/5 * * * *"] },
	"observability": { "enabled": true },
	// Per client IP, per Cloudflare location, approximate. A page load is 1-3 requests.
	"ratelimits": [
		{ "name": "GQL_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
		{ "name": "CODE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
	],
	"containers": [
		{
			"class_name": "Api",
			"image": "../../api/Dockerfile",
			"image_build_context": "../../api",
			"max_instances": 1
		}
	],
	"durable_objects": { "bindings": [{ "name": "API", "class_name": "Api" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Api"] }]
}
